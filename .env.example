# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/school_management

# Optional: used for local file storage. Defaults to ./uploads
UPLOAD_DIR=./uploads

# Optional server port
PORT=3000

# Optional public donation/support link shown as a Donate button in the app
# Example: https://ko-fi.com/yourname or your PayPal donation page
DONATION_URL=
