<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>@yield('title', 'Admin Panel') - Madrassati</title>

<style>
    :root {
        --primary: #087443;
        --primary-dark: #075B36;
        --secondary: #2563EB;
        --accent: #F59E0B;

        --background: #F8FAFC;
        --cards: #FFFFFF;

        --text: #172033;
        --text-secondary: #64748B;

        --danger: #DC2626;
        --success: #16A34A;

        --border: #E2E8F0;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: var(--background);
        color: var(--text);
    }

    /* Sidebar */

    .sidebar {
        position: fixed;
        left: 0;
        top: 0;

        width: 250px;
        height: 100vh;

        background: var(--primary-dark);
        color: white;

        padding: 24px 16px;

        overflow-y: auto;
    }

    .logo {
        padding: 0 12px 25px;

        font-size: 26px;
        font-weight: bold;

        border-bottom: 1px solid rgba(255, 255, 255, 0.15);

        margin-bottom: 20px;
    }

    .logo span {
        color: var(--accent);
    }

    .sidebar a {
        display: block;

        color: #E8F5EF;
        text-decoration: none;

        padding: 12px 14px;
        margin-bottom: 5px;

        border-radius: 8px;

        transition: 0.2s;
    }

    .sidebar a:hover {
        background: var(--primary);
        color: white;
    }

    .sidebar a.active {
        background: white;
        color: var(--primary-dark);
        font-weight: bold;
    }

    /* Logout */

    .logout {
        margin-top: 30px;

        padding-top: 20px;

        border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .logout button {
        width: 100%;

        padding: 11px;

        border: none;
        border-radius: 8px;

        background: var(--danger);
        color: white;

        font-size: 14px;
        font-weight: bold;

        cursor: pointer;
    }

    .logout button:hover {
        opacity: 0.9;
    }

    /* Main content */

    .content {
        margin-left: 250px;

        min-height: 100vh;

        padding: 30px;
    }

    /* Top bar */

    .topbar {
        background: var(--cards);

        padding: 18px 22px;

        margin-bottom: 25px;

        border-radius: 12px;

        border: 1px solid var(--border);

        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }

    .topbar strong {
        color: var(--primary-dark);
        font-size: 18px;
    }

    /* Cards */

    .card {
        background: var(--cards);

        border: 1px solid var(--border);

        border-radius: 12px;

        padding: 24px;

        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }

    /* Buttons */

    .btn {
        display: inline-block;

        padding: 10px 16px;

        border: none;
        border-radius: 8px;

        text-decoration: none;

        font-weight: bold;

        cursor: pointer;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
    }

    .btn-primary:hover {
        background: var(--primary-dark);
    }

    .btn-secondary {
        background: var(--secondary);
        color: white;
    }

    .btn-danger {
        background: var(--danger);
        color: white;
    }

    .btn-success {
        background: var(--success);
        color: white;
    }

    .btn-accent {
        background: var(--accent);
        color: white;
    }

    /* Headings */

    h1,
    h2,
    h3 {
        color: var(--text);
    }

    /* Tables */

    table {
        width: 100%;

        border-collapse: collapse;

        background: var(--cards);
    }

    th {
        background: var(--primary-dark);
        color: white;

        text-align: left;

        padding: 12px;
    }

    td {
        padding: 12px;

        border-bottom: 1px solid var(--border);
    }

    tr:hover {
        background: #F1F5F9;
    }

    /* Forms */

    input,
    select,
    textarea {
        width: 100%;

        padding: 10px 12px;

        border: 1px solid var(--border);

        border-radius: 8px;

        background: white;

        color: var(--text);

        font-size: 14px;
    }

    input:focus,
    select:focus,
    textarea:focus {
        outline: none;

        border-color: var(--primary);

        box-shadow: 0 0 0 3px rgba(8, 116, 67, 0.12);
    }

    label {
        display: block;

        margin-bottom: 6px;

        font-weight: bold;

        color: var(--text);
    }

    /* Alerts */

    .alert-success {
        background: #DCFCE7;
        color: #166534;

        border: 1px solid #BBF7D0;

        padding: 12px 16px;

        border-radius: 8px;

        margin-bottom: 20px;
    }

    .alert-danger {
        background: #FEE2E2;
        color: #991B1B;

        border: 1px solid #FECACA;

        padding: 12px 16px;

        border-radius: 8px;

        margin-bottom: 20px;
    }

    /* Mobile */
    .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.form-actions {
    display: flex;
    gap: 10px;
    align-items: center;
}

.btn-sm {
    padding: 6px 10px;
    font-size: 13px;
}

@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-actions {
        flex-wrap: wrap;
    }
}
    @media (max-width: 768px) {

        .sidebar {
            width: 210px;
        }

        .content {
            margin-left: 210px;
            padding: 20px;
        }
    }
</style>


</head>

